rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Public marketplace items collection
    match /items/{itemId} {
      allow read: if isValidId(itemId);
      allow create: if isValidId(itemId) 
        && request.resource.data.title is string 
        && request.resource.data.title.size() <= 120
        && request.resource.data.price is number;
      allow update: if isValidId(itemId);
      allow delete: if isValidId(itemId);
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow write: if isValidId(userId);
    }
  }
}
